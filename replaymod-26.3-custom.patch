@@ -0,0 +1,70 @@
+package com.replaymod.replay.ext;
+
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.sound.PositionedSoundInstance;
+import net.minecraft.network.PacketByteBuf;
+import net.minecraft.sound.SoundCategory;
+import net.minecraft.sound.SoundEvent;
+import net.minecraft.util.Identifier;
+
+//#if MC>=11900
+//$$ import net.minecraft.util.math.random.Random;
+//#endif
+
+/**
+ * Plays back the sounds stored by {@link com.replaymod.recording.ext.ExtRecorder}.
+ */
+public final class ExtPlayback {
+    private ExtPlayback() {}
+
+    /**
+     * Reads a recorded sound from the packet payload and plays it. May be called from any thread,
+     * the sound is started on the main thread.
+     */
+    public static void playSound(PacketByteBuf buf) {
+        Identifier id = buf.readIdentifier();
+        String categoryName = buf.readString();
+        double x = buf.readDouble();
+        double y = buf.readDouble();
+        double z = buf.readDouble();
+        float volume = buf.readFloat();
+        float pitch = buf.readFloat();
+
+        SoundCategory category = null;
+        for (SoundCategory candidate : SoundCategory.values()) {
+            if (candidate.getName().equals(categoryName)) {
+                category = candidate;
+                break;
+            }
+        }
+        if (category == null || category == SoundCategory.MASTER) {
+            return;
+        }
+        final SoundCategory finalCategory = category;
+
+        playAt(new SoundEvent(id), finalCategory, volume, pitch, x, y, z);
+    }
+
+    /** Plays a sound at a world position, on the main thread. */
+    public static void playAt(SoundEvent event, SoundCategory category, float volume, float pitch,
+                              double x, double y, double z) {
+        MinecraftClient mc = MinecraftClient.getInstance();
+        Runnable play = () -> {
+            if (mc.world == null) {
+                return;
+            }
+            mc.getSoundManager().play(new PositionedSoundInstance(
+                    event, category, volume, pitch,
+                    //#if MC>=11900
+                    //$$ Random.create(),
+                    //#endif
+                    x, y, z
+            ));
+        };
+        if (mc.isOnThread()) {
+            play.run();
+        } else {
+            mc.execute(play);
+        }
+    }
+}
diff --git a/src/main/java/com/replaymod/replay/ext/ReplayHud.java b/src/main/java/com/replaymod/replay/ext/ReplayHud.java
new file mode 100644
index 00000000..343f87dd
--- /dev/null
+++ b/src/main/java/com/replaymod/replay/ext/ReplayHud.java
@@ -0,0 +1,191 @@
+package com.replaymod.replay.ext;
+
+import com.replaymod.recording.ext.ExtItems;
+import com.replaymod.render.hooks.EntityRendererHandler;
+import com.replaymod.replay.ReplayModReplay;
+import com.replaymod.replay.camera.CameraEntity;
+import io.netty.buffer.Unpooled;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.network.ClientPlayerInteractionManager;
+import net.minecraft.entity.Entity;
+import net.minecraft.entity.attribute.EntityAttributes;
+import net.minecraft.entity.player.PlayerEntity;
+import net.minecraft.entity.player.PlayerInventory;
+import net.minecraft.item.ItemStack;
+import net.minecraft.network.PacketByteBuf;
+import net.minecraft.world.GameMode;
+
+/**
+ * Survival HUD (crosshair, hotbar, hearts, hunger, armor, air, experience) for replays that were recorded with
+ * {@link com.replaymod.recording.ext.ExtRecorder}.
+ * <p>
+ * Instead of drawing the HUD ourselves, the recorded values are put into the player which the replay is viewed
+ * through and the game is told that it is not in spectator mode while it draws its HUD. The game then draws its
+ * regular HUD (with the correct look for the Minecraft version and resource pack).
+ */
+public final class ReplayHud {
+    private ReplayHud() {}
+
+    private static class Snapshot {
+        int gameMode;
+        int selectedSlot;
+        float health;
+        float maxHealth;
+        float absorption;
+        int food;
+        float saturation;
+        int armor;
+        int air;
+        int maxAir;
+        float xpProgress;
+        int xpLevel;
+        final ItemStack[] hotbar = new ItemStack[9];
+        ItemStack offhand = ItemStack.EMPTY;
+    }
+
+    /** The latest recorded snapshot, still encoded because it can only be decoded on the main thread. */
+    private static volatile byte[] raw;
+    private static byte[] decodedFrom;
+    private static Snapshot decoded;
+
+    private static boolean active;
+    private static GameMode realMode;
+
+    /** Forgets everything, called when the replay (re)starts from the beginning. */
+    public static void reset() {
+        raw = null;
+        decodedFrom = null;
+        decoded = null;
+    }
+
+    /** Stores a recorded HUD snapshot. May be called from any thread. */
+    public static void update(PacketByteBuf buf) {
+        byte[] bytes = new byte[buf.readableBytes()];
+        buf.getBytes(buf.readerIndex(), bytes);
+        raw = bytes;
+    }
+
+    /** Whether the game's HUD is currently showing the recorded values. */
+    public static boolean isActive() {
+        return active;
+    }
+
+    private static Snapshot snapshot() {
+        byte[] bytes = raw;
+        if (bytes == null) {
+            return null;
+        }
+        if (bytes != decodedFrom) {
+            decodedFrom = bytes;
+            decoded = null;
+            try {
+                PacketByteBuf buf = new PacketByteBuf(Unpooled.wrappedBuffer(bytes));
+                if (buf.readByte() == 1) {
+                    Snapshot s = new Snapshot();
+                    s.gameMode = buf.readByte();
+                    s.selectedSlot = buf.readByte();
+                    s.health = buf.readFloat();
+                    s.maxHealth = buf.readFloat();
+                    s.absorption = buf.readFloat();
+                    s.food = buf.readInt();
+                    s.saturation = buf.readFloat();
+                    s.armor = buf.readInt();
+                    s.air = buf.readInt();
+                    s.maxAir = buf.readInt();
+                    s.xpProgress = buf.readFloat();
+                    s.xpLevel = buf.readInt();
+                    for (int i = 0; i < 9; i++) {
+                        s.hotbar[i] = ExtItems.read(buf);
+                    }
+                    s.offhand = ExtItems.read(buf);
+                    decoded = s;
+                }
+            } catch (Throwable t) {
+                decoded = null;
+            }
+        }
+        return decoded;
+    }
+
+    /** Called right before the game draws its HUD. */
+    public static void begin() {
+        try {
+            end(); // never stay in the pretend mode if the end of the previous frame was skipped
+            MinecraftClient mc = MinecraftClient.getInstance();
+            if (ReplayModReplay.instance.getReplayHandler() == null || mc.world == null) {
+                return;
+            }
+            ClientPlayerInteractionManager interactionManager = mc.interactionManager;
+            Entity view = mc.getCameraEntity();
+            if (interactionManager == null || !(view instanceof PlayerEntity) || view instanceof CameraEntity) {
+                return;
+            }
+            EntityRendererHandler renderer = ((EntityRendererHandler.IEntityRenderer) mc.gameRenderer).replayModRender_getHandler();
+            if (renderer != null && !renderer.getSettings().isRenderHud()) {
+                return; // the HUD is not wanted in the video
+            }
+            Snapshot s = snapshot();
+            if (s == null || s.gameMode < 0 || s.gameMode > 2) {
+                return; // nothing recorded or the player was spectating
+            }
+            PlayerEntity player = (PlayerEntity) view;
+            apply(player, s);
+            if (mc.player != null && mc.player != player) {
+                mc.player.experienceProgress = s.xpProgress;
+                mc.player.experienceLevel = s.xpLevel;
+            }
+            realMode = interactionManager.getCurrentGameMode();
+            interactionManager.setGameMode(GameMode.byId(s.gameMode));
+            active = true;
+        } catch (Throwable t) {
+            active = false;
+        }
+    }
+
+    /** Called right after the game drew its HUD (and as a safety net every tick). */
+    public static void end() {
+        if (!active) {
+            return;
+        }
+        active = false;
+        try {
+            ClientPlayerInteractionManager interactionManager = MinecraftClient.getInstance().interactionManager;
+            if (interactionManager != null && realMode != null) {
+                interactionManager.setGameMode(realMode);
+            }
+        } catch (Throwable ignored) {
+            // nothing we could do
+        }
+    }
+
+    private static void apply(PlayerEntity player, Snapshot s) {
+        player.experienceProgress = s.xpProgress;
+        player.experienceLevel = s.xpLevel;
+
+        PlayerInventory inventory = player.inventory;
+        for (int i = 0; i < 9; i++) {
+            if (s.hotbar[i] != null) {
+                inventory.setStack(i, s.hotbar[i]);
+            }
+        }
+        if (s.offhand != null) {
+            inventory.setStack(40, s.offhand);
+        }
+        //#if MC>=12105
+        //$$ inventory.setSelectedSlot(Math.max(0, Math.min(8, s.selectedSlot)));
+        //#else
+        inventory.selectedSlot = Math.max(0, Math.min(8, s.selectedSlot));
+        //#endif
+
+        player.getHungerManager().setFoodLevel(s.food);
+        player.setAbsorptionAmount(s.absorption);
+        player.setAir(s.air);
+        if (player.getAttributeInstance(EntityAttributes.GENERIC_MAX_HEALTH) != null) {
+            player.getAttributeInstance(EntityAttributes.GENERIC_MAX_HEALTH).setBaseValue(s.maxHealth);
+        }
+        if (player.getAttributeInstance(EntityAttributes.GENERIC_ARMOR) != null) {
+            player.getAttributeInstance(EntityAttributes.GENERIC_ARMOR).setBaseValue(s.armor);
+        }
+        player.setHealth(s.health);
+    }
+}
diff --git a/src/main/java/com/replaymod/replay/ext/ReplayMovementSounds.java b/src/main/java/com/replaymod/replay/ext/ReplayMovementSounds.java
new file mode 100644
index 00000000..364e008f
--- /dev/null
+++ b/src/main/java/com/replaymod/replay/ext/ReplayMovementSounds.java
@@ -0,0 +1,173 @@
+package com.replaymod.replay.ext;
+
+import net.minecraft.block.BlockState;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.world.ClientWorld;
+import net.minecraft.entity.Entity;
+import net.minecraft.entity.player.PlayerEntity;
+import net.minecraft.sound.BlockSoundGroup;
+import net.minecraft.sound.SoundCategory;
+import net.minecraft.sound.SoundEvent;
+import net.minecraft.util.Identifier;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.util.math.MathHelper;
+import net.minecraft.util.math.Vec3d;
+
+import java.util.Random;
+
+import static de.johni0702.minecraft.gui.versions.MCVer.identifier;
+
+/**
+ * Generates the movement sounds of the recorded player (footsteps, splashing, swimming, landing) while a replay plays.
+ * <p>
+ * The server never sends a player their own movement sounds, so they are missing from the replay file.
+ * Like the game itself does, this derives them from how far the player moved, whether they are on the ground or
+ * in water, and the block they are standing on. It is only active when the replay does not contain sounds which were
+ * recorded by the player's own game, so nothing is played twice.
+ */
+public final class ReplayMovementSounds {
+    private static final Random RANDOM = new Random();
+
+    private static boolean hasLast;
+    private static double lastX, lastY, lastZ;
+    private static boolean wasOnGround;
+    private static boolean wasInWater;
+    private static float distanceTraveled;
+    private static float nextStepDistance;
+    private static double fallDistance;
+
+    private ReplayMovementSounds() {}
+
+    /** Forget the previous state, e.g. because the replay restarted or time jumped. */
+    public static void reset() {
+        hasLast = false;
+    }
+
+    /**
+     * Called once per game tick while a replay is open.
+     *
+     * @param entityId the entity id of the player who recorded the replay
+     * @param disabled whether the replay already contains the sounds of the player's own game
+     * @param hurrying whether the replay is currently fast-forwarding to a point in time
+     */
+    public static void tick(int entityId, boolean disabled, boolean hurrying) {
+        try {
+            tickUnsafe(entityId, disabled, hurrying);
+        } catch (Throwable t) {
+            hasLast = false; // never break the replay because of this
+        }
+    }
+
+    private static void tickUnsafe(int entityId, boolean disabled, boolean hurrying) {
+        MinecraftClient mc = MinecraftClient.getInstance();
+        ClientWorld world = mc.world;
+        if (world == null || disabled || hurrying || entityId < 0) {
+            hasLast = false;
+            return;
+        }
+        Entity entity = world.getEntityById(entityId);
+        if (!(entity instanceof PlayerEntity)) {
+            hasLast = false;
+            return;
+        }
+
+        Vec3d pos = entity.getPos();
+        boolean onGround = entity.isOnGround();
+        boolean inWater = entity.isTouchingWater();
+
+        if (!hasLast) {
+            remember(pos, onGround, inWater);
+            distanceTraveled = 0;
+            nextStepDistance = 1;
+            fallDistance = 0;
+            hasLast = true;
+            return;
+        }
+
+        double dx = pos.x - lastX;
+        double dy = pos.y - lastY;
+        double dz = pos.z - lastZ;
+        double length = Math.sqrt(dx * dx + dy * dy + dz * dz);
+        if (length > 8) {
+            // teleport or jump in time, not actual movement
+            remember(pos, onGround, inWater);
+            distanceTraveled = 0;
+            nextStepDistance = 1;
+            fallDistance = 0;
+            return;
+        }
+
+        boolean sneaking = entity.isSneaking();
+        double speed = Math.sqrt(dx * dx * 0.2 + dy * dy + dz * dz * 0.2);
+
+        // Falling
+        if (onGround || inWater) {
+            if (!wasOnGround && !wasInWater && fallDistance > 3.0) {
+                playLanding(world, pos, fallDistance);
+            }
+            fallDistance = 0;
+        } else if (dy < 0) {
+            fallDistance -= dy;
+        }
+
+        // Entering the water
+        if (inWater && !wasInWater) {
+            float volume = (float) Math.min(1.0, speed * 0.2);
+            String id = volume < 0.25f ? "entity.player.splash" : "entity.player.splash.high_speed";
+            play(id, volume, randomPitch(), pos);
+        }
+
+        // Steps / swimming strokes, based on the distance traveled like in the game
+        distanceTraveled += (float) length * 0.6f;
+        if (distanceTraveled > nextStepDistance) {
+            BlockPos below = new BlockPos(MathHelper.floor(pos.x), MathHelper.floor(pos.y - 0.2), MathHelper.floor(pos.z));
+            BlockState state = world.getBlockState(below);
+            if (!state.isAir()) {
+                nextStepDistance = (int) distanceTraveled + 1;
+                if (inWater) {
+                    float volume = (float) Math.min(0.7, speed * 0.25);
+                    play("entity.player.swim", volume, randomPitch(), pos);
+                } else if (onGround) {
+                    BlockSoundGroup group = state.getSoundGroup();
+                    float volume = group.getVolume() * 0.1f * (sneaking ? 0.3f : 1.0f);
+                    playEvent(group.getStepSound(), volume, group.getPitch(), pos);
+                }
+            }
+        }
+
+        remember(pos, onGround, inWater);
+    }
+
+    private static void playLanding(ClientWorld world, Vec3d pos, double fallDistance) {
+        play(fallDistance > 4 ? "entity.player.big_fall" : "entity.player.small_fall", 1.0f, 1.0f, pos);
+        BlockPos below = new BlockPos(MathHelper.floor(pos.x), MathHelper.floor(pos.y - 0.2), MathHelper.floor(pos.z));
+        BlockState state = world.getBlockState(below);
+        if (!state.isAir()) {
+            BlockSoundGroup group = state.getSoundGroup();
+            playEvent(group.getFallSound(), group.getVolume() * 0.5f, group.getPitch() * 0.75f, pos);
+        }
+    }
+
+    private static void remember(Vec3d pos, boolean onGround, boolean inWater) {
+        lastX = pos.x;
+        lastY = pos.y;
+        lastZ = pos.z;
+        wasOnGround = onGround;
+        wasInWater = inWater;
+    }
+
+    private static float randomPitch() {
+        return 1.0f + (RANDOM.nextFloat() - RANDOM.nextFloat()) * 0.4f;
+    }
+
+    private static void play(String eventId, float volume, float pitch, Vec3d pos) {
+        playEvent(new SoundEvent(identifier("minecraft", eventId)), volume, pitch, pos);
+    }
+
+    private static void playEvent(SoundEvent event, float volume, float pitch, Vec3d pos) {
+        if (volume <= 0) {
+            return;
+        }
+        ExtPlayback.playAt(event, SoundCategory.PLAYERS, volume, pitch, pos.x, pos.y, pos.z);
+    }
+}
