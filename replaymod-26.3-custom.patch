+++ b/src/main/java/com/replaymod/recording/ext/ExtRecorder.java
@@ -0,0 +1,158 @@
+package com.replaymod.recording.ext;
+
+import com.replaymod.recording.handler.RecordingEventHandler;
+import io.netty.buffer.Unpooled;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.network.ClientPlayerEntity;
+import net.minecraft.client.sound.SoundInstance;
+import net.minecraft.entity.player.PlayerEntity;
+import net.minecraft.entity.player.PlayerInventory;
+import net.minecraft.network.PacketByteBuf;
+import net.minecraft.sound.SoundCategory;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.util.Arrays;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Records what the recording player's own game does that is never sent by the server: every sound they hear
+ * (footsteps, splashes, ...) and the state shown by their HUD (hotbar, hearts, hunger, experience, ...).
+ */
+public class ExtRecorder {
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final int HUD_VERSION = 1;
+
+    /** Number of times the sound hook ran / found no active recording. Only used for diagnostics. */
+    public static final AtomicInteger HOOK_CALLS = new AtomicInteger();
+    public static final AtomicInteger HOOK_NO_HANDLER = new AtomicInteger();
+
+    private int seen, skipCategory, skipRepeatable, skipRelative, skipAttenuation, skipVolume, failures;
+    private String lastFailure = "";
+    private int ticks;
+
+    private final RecordingEventHandler handler;
+    private byte[] lastHud;
+    private boolean markerSent;
+    private boolean failureLogged;
+    private int soundsRecorded;
+
+    public ExtRecorder(RecordingEventHandler handler) {
+        this.handler = handler;
+    }
+
+    /** Called every client tick while recording. */
+    public void onTick(ClientPlayerEntity player) {
+        try {
+            if (!markerSent) {
+                markerSent = true;
+                PacketByteBuf marker = new PacketByteBuf(Unpooled.buffer());
+                marker.writeByte(1);
+                handler.saveExt(ExtChannels.MARKER, marker);
+            }
+            recordHud(player);
+            ticks++;
+            if (ticks == 40 || ticks % 200 == 0) {
+                PacketByteBuf diag = new PacketByteBuf(Unpooled.buffer());
+                diag.writeString("tick=" + ticks + " hookCalls=" + HOOK_CALLS.get() + " noHandler=" + HOOK_NO_HANDLER.get()
+                        + " seen=" + seen + " recorded=" + soundsRecorded + " skipCategory=" + skipCategory
+                        + " skipRepeatable=" + skipRepeatable + " skipRelative=" + skipRelative
+                        + " skipAttenuation=" + skipAttenuation + " skipVolume=" + skipVolume
+                        + " failures=" + failures + " lastFailure=" + lastFailure);
+                handler.saveExt(ExtChannels.DIAG, diag);
+            }
+        } catch (Throwable t) {
+            logFailure(t);
+        }
+    }
+
+    private void recordHud(ClientPlayerEntity player) {
+        MinecraftClient mc = MinecraftClient.getInstance();
+        PacketByteBuf buf = new PacketByteBuf(Unpooled.buffer());
+        buf.writeByte(HUD_VERSION);
+        int gameMode = mc.interactionManager != null ? mc.interactionManager.getCurrentGameMode().getId() : 0;
+        buf.writeByte(gameMode);
+        PlayerEntity playerEntity = player;
+        PlayerInventory inventory = playerEntity.inventory;
+        //#if MC>=12105
+        //$$ buf.writeByte(inventory.getSelectedSlot());
+        //#else
+        buf.writeByte(inventory.selectedSlot);
+        //#endif
+        buf.writeFloat(player.getHealth());
+        buf.writeFloat(player.getMaxHealth());
+        buf.writeFloat(player.getAbsorptionAmount());
+        buf.writeInt(player.getHungerManager().getFoodLevel());
+        buf.writeFloat(player.getHungerManager().getSaturationLevel());
+        buf.writeInt(player.getArmor());
+        buf.writeInt(player.getAir());
+        buf.writeInt(player.getMaxAir());
+        buf.writeFloat(player.experienceProgress);
+        buf.writeInt(player.experienceLevel);
+        for (int slot = 0; slot < 9; slot++) {
+            ExtItems.write(buf, inventory.getStack(slot));
+        }
+        ExtItems.write(buf, inventory.getStack(40)); // off hand
+
+        byte[] current = new byte[buf.readableBytes()];
+        buf.getBytes(buf.readerIndex(), current);
+        if (Arrays.equals(current, lastHud)) {
+            return;
+        }
+        lastHud = current;
+        handler.saveExt(ExtChannels.HUD, buf);
+    }
+
+    /** Called for every sound the game starts while recording. */
+    public void onSound(SoundInstance instance) {
+        try {
+            seen++;
+            SoundCategory category = instance.getCategory();
+            if (category == SoundCategory.MASTER || category == SoundCategory.MUSIC || category == SoundCategory.RECORDS) {
+                skipCategory++;
+                return; // GUI sounds and music are not part of a recording
+            }
+            if (instance.isRepeatable() || !instance.canPlay()) {
+                skipRepeatable++;
+                return; // looping sounds cannot be replayed from a single packet
+            }
+            if (instance.isLooping() /* 1.16.4 name of the "relative" flag, remapped for newer versions */) {
+                skipRelative++;
+                return; // listener relative sounds have no world position
+            }
+            if (!"LINEAR".equals(instance.getAttenuationType().name())) {
+                skipAttenuation++;
+                return;
+            }
+            float volume = instance.getVolume();
+            if (!(volume > 0)) {
+                skipVolume++;
+                return;
+            }
+            PacketByteBuf buf = new PacketByteBuf(Unpooled.buffer());
+            buf.writeIdentifier(instance.getId());
+            buf.writeString(category.getName());
+            buf.writeDouble(instance.getX());
+            buf.writeDouble(instance.getY());
+            buf.writeDouble(instance.getZ());
+            buf.writeFloat(volume);
+            buf.writeFloat(instance.getPitch());
+            handler.saveExt(ExtChannels.SOUND, buf);
+            soundsRecorded++;
+            if (soundsRecorded <= 5 || soundsRecorded % 100 == 0) {
+                LOGGER.info("Recorded extra replay sound #{}: {}", soundsRecorded, instance.getId());
+            }
+        } catch (Throwable t) {
+            logFailure(t);
+        }
+    }
+
+    private void logFailure(Throwable t) {
+        failures++;
+        lastFailure = t.getClass().getName() + ": " + t.getMessage();
+        if (!failureLogged) {
+            failureLogged = true;
+            LOGGER.warn("Failed to record extra replay data:", t);
+        }
+    }
+}
