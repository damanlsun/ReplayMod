+package com.replaymod.replay.ext;
+
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.sound.PositionedSoundInstance;
+import net.minecraft.network.PacketByteBuf;
+import net.minecraft.sound.SoundCategory;
+import net.minecraft.sound.SoundEvent;
+import net.minecraft.util.Identifier;
+
+//#if MC>=11900
+//$$ import net.minecraft.util.math.random.Random;
+//#endif
+
+/**
+ * Plays back the sounds stored by {@link com.replaymod.recording.ext.ExtRecorder}.
+ */
+public final class ExtPlayback {
+    private ExtPlayback() {}
+
+    /**
+     * Reads a recorded sound from the packet payload and plays it. May be called from any thread,
+     * the sound is started on the main thread.
+     */
+    public static void playSound(PacketByteBuf buf) {
+        Identifier id = buf.readIdentifier();
+        String categoryName = buf.readString();
+        double x = buf.readDouble();
+        double y = buf.readDouble();
+        double z = buf.readDouble();
+        float volume = buf.readFloat();
+        float pitch = buf.readFloat();
+
+        SoundCategory category = null;
+        for (SoundCategory candidate : SoundCategory.values()) {
+            if (candidate.getName().equals(categoryName)) {
+                category = candidate;
+                break;
+            }
+        }
+        if (category == null || category == SoundCategory.MASTER) {
+            return;
+        }
+        final SoundCategory finalCategory = category;
+
+        MinecraftClient mc = MinecraftClient.getInstance();
+        Runnable play = () -> {
+            if (mc.world == null) {
+                return;
+            }
+            mc.getSoundManager().play(new PositionedSoundInstance(
+                    new SoundEvent(id), finalCategory, volume, pitch,
+                    //#if MC>=11900
+                    //$$ Random.create(),
+                    //#endif
+                    x, y, z
+            ));
+        };
+        if (mc.isOnThread()) {
+            play.run();
+        } else {
+            mc.execute(play);
+        }
+    }
+}
diff --git a/src/main/java/com/replaymod/replay/ext/ReplayHud.java b/src/main/java/com/replaymod/replay/ext/ReplayHud.java
new file mode 100644
index 00000000..dfef630c
--- /dev/null
+++ b/src/main/java/com/replaymod/replay/ext/ReplayHud.java
@@ -0,0 +1,239 @@
+package com.replaymod.replay.ext;
+
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.replaymod.replay.ReplayModReplay;
+import com.replaymod.replay.camera.CameraEntity;
+import net.minecraft.client.MinecraftClient;
+import net.minecraft.client.gui.DrawableHelper;
+import net.minecraft.client.util.math.MatrixStack;
+import net.minecraft.entity.Entity;
+import net.minecraft.entity.player.PlayerEntity;
+import net.minecraft.item.ItemStack;
+import net.minecraft.network.PacketByteBuf;
+import net.minecraft.util.Identifier;
+
+import static com.replaymod.core.versions.MCVer.bindTexture;
+
+/**
+ * Survival HUD (crosshair, hotbar, hearts, hunger, armor, air, experience) for replays that were recorded with
+ * {@link com.replaymod.recording.ext.ExtRecorder}. Shown while viewing the replay through a player's eyes.
+ */
+public class ReplayHud extends DrawableHelper {
+    public static final ReplayHud INSTANCE = new ReplayHud();
+
+    private static final Identifier WIDGETS = new Identifier("textures/gui/widgets.png");
+
+    private static class Snapshot {
+        int gameMode;
+        int selectedSlot;
+        float health;
+        float maxHealth;
+        float absorption;
+        int food;
+        float saturation;
+        int armor;
+        int air;
+        int maxAir;
+        float xpProgress;
+        int xpLevel;
+        final ItemStack[] hotbar = new ItemStack[9];
+        ItemStack offhand = ItemStack.EMPTY;
+    }
+
+    private static volatile Snapshot current;
+
+    /** Forgets everything, called when the replay (re)starts from the beginning. */
+    public static void reset() {
+        current = null;
+    }
+
+    /** Applies a recorded HUD snapshot. May be called from any thread. */
+    public static void update(PacketByteBuf buf) {
+        int version = buf.readByte();
+        if (version != 1) {
+            return;
+        }
+        Snapshot s = new Snapshot();
+        s.gameMode = buf.readByte();
+        s.selectedSlot = buf.readByte();
+        s.health = buf.readFloat();
+        s.maxHealth = buf.readFloat();
+        s.absorption = buf.readFloat();
+        s.food = buf.readInt();
+        s.saturation = buf.readFloat();
+        s.armor = buf.readInt();
+        s.air = buf.readInt();
+        s.maxAir = buf.readInt();
+        s.xpProgress = buf.readFloat();
+        s.xpLevel = buf.readInt();
+        for (int i = 0; i < 9; i++) {
+            s.hotbar[i] = buf.readItemStack();
+        }
+        s.offhand = buf.readItemStack();
+        current = s;
+    }
+
+    private static boolean shouldRender(MinecraftClient mc) {
+        if (ReplayModReplay.instance.getReplayHandler() == null) {
+            return false;
+        }
+        if (mc.options.hudHidden) {
+            return false;
+        }
+        Entity view = mc.getCameraEntity();
+        return view instanceof PlayerEntity && !(view instanceof CameraEntity);
+    }
+
+    /** Draws the HUD, called at the end of the regular in-game HUD rendering. */
+    public void render(MatrixStack matrices) {
+        Snapshot s = current;
+        MinecraftClient mc = MinecraftClient.getInstance();
+        if (s == null || !shouldRender(mc)) {
+            return;
+        }
+        int w = mc.getWindow().getScaledWidth();
+        int h = mc.getWindow().getScaledHeight();
+
+        RenderSystem.enableBlend();
+        resetColor();
+
+        // Crosshair
+        bindTexture(GUI_ICONS_TEXTURE);
+        // GL_ONE_MINUS_DST_COLOR, GL_ONE_MINUS_SRC_COLOR, GL_ONE, GL_ZERO (the vanilla inverted crosshair blending)
+        RenderSystem.blendFuncSeparate(0x0307, 0x0301, 1, 0);
+        drawTexture(matrices, (w - 15) / 2, (h - 15) / 2, 0, 0, 15, 15);
+        RenderSystem.defaultBlendFunc();
+
+        // Hotbar
+        bindTexture(WIDGETS);
+        drawTexture(matrices, w / 2 - 91, h - 22, 0, 0, 182, 22);
+        drawTexture(matrices, w / 2 - 91 - 1 + s.selectedSlot * 20, h - 22 - 1, 0, 22, 24, 24);
+        if (!s.offhand.isEmpty()) {
+            drawTexture(matrices, w / 2 - 91 - 29, h - 23, 24, 22, 29, 24);
+        }
+        for (int i = 0; i < 9; i++) {
+            renderItem(mc, s.hotbar[i], w / 2 - 90 + i * 20 + 2, h - 16 - 3);
+        }
+        renderItem(mc, s.offhand, w / 2 - 91 - 26, h - 16 - 3);
+
+        // Status bars (not shown in creative / spectator mode)
+        resetColor();
+        bindTexture(GUI_ICONS_TEXTURE);
+        if (s.gameMode == 0 || s.gameMode == 2) {
+            renderStatus(matrices, s, w, h);
+            renderExperience(mc, matrices, s, w, h);
+        }
+        resetColor();
+        RenderSystem.disableBlend();
+    }
+
+    private void renderItem(MinecraftClient mc, ItemStack stack, int x, int y) {
+        if (stack == null || stack.isEmpty()) {
+            return;
+        }
+        mc.getItemRenderer().renderInGuiWithOverrides(stack, x, y);
+        mc.getItemRenderer().renderGuiItemOverlay(mc.textRenderer, stack, x, y);
+    }
+
+    private void renderStatus(MatrixStack matrices, Snapshot s, int w, int h) {
+        int left = w / 2 - 91;
+        int right = w / 2 + 91;
+        int bottom = h - 39;
+
+        float maxHealth = Math.max(s.maxHealth, s.health);
+        int absorption = (int) Math.ceil(s.absorption);
+        int rows = (int) Math.ceil((maxHealth + absorption) / 2.0f / 10.0f);
+        int rowHeight = Math.max(10 - (rows - 2), 3);
+
+        // Armor
+        if (s.armor > 0) {
+            int y = bottom - (rows - 1) * rowHeight - 10;
+            for (int i = 0; i < 10; i++) {
+                int x = left + i * 8;
+                if (i * 2 + 1 < s.armor) {
+                    drawTexture(matrices, x, y, 34, 9, 9, 9);
+                } else if (i * 2 + 1 == s.armor) {
+                    drawTexture(matrices, x, y, 25, 9, 9, 9);
+                } else {
+                    drawTexture(matrices, x, y, 16, 9, 9, 9);
+                }
+            }
+        }
+
+        // Health (red) followed by absorption (golden) hearts
+        int health = (int) Math.ceil(s.health);
+        int normalHearts = (int) Math.ceil(maxHealth / 2.0f);
+        for (int i = 0; i < normalHearts; i++) {
+            int x = left + (i % 10) * 8;
+            int y = bottom - (i / 10) * rowHeight;
+            drawTexture(matrices, x, y, 16, 0, 9, 9);
+            if (i * 2 + 1 < health) {
+                drawTexture(matrices, x, y, 52, 0, 9, 9);
+            } else if (i * 2 + 1 == health) {
+                drawTexture(matrices, x, y, 61, 0, 9, 9);
+            }
+        }
+        int absorptionHearts = (int) Math.ceil(absorption / 2.0f);
+        for (int i = 0; i < absorptionHearts; i++) {
+            int index = normalHearts + i;
+            int x = left + (index % 10) * 8;
+            int y = bottom - (index / 10) * rowHeight;
+            drawTexture(matrices, x, y, 16, 0, 9, 9);
+            if (i * 2 + 1 < absorption) {
+                drawTexture(matrices, x, y, 160, 0, 9, 9);
+            } else {
+                drawTexture(matrices, x, y, 169, 0, 9, 9);
+            }
+        }
+
+        // Hunger
+        for (int i = 0; i < 10; i++) {
+            int x = right - i * 8 - 9;
+            drawTexture(matrices, x, bottom, 16, 27, 9, 9);
+            if (i * 2 + 1 < s.food) {
+                drawTexture(matrices, x, bottom, 52, 27, 9, 9);
+            } else if (i * 2 + 1 == s.food) {
+                drawTexture(matrices, x, bottom, 61, 27, 9, 9);
+            }
+        }
+
+        // Air bubbles
+        if (s.maxAir > 0 && s.air < s.maxAir) {
+            int full = Math.max(0, (int) Math.ceil((s.air - 2) * 10.0 / s.maxAir));
+            int popping = Math.max(0, (int) Math.ceil(s.air * 10.0 / s.maxAir) - full);
+            for (int i = 0; i < full + popping; i++) {
+                int x = right - i * 8 - 9;
+                drawTexture(matrices, x, bottom - 10, i < full ? 16 : 25, 18, 9, 9);
+            }
+        }
+    }
+
+    private void renderExperience(MinecraftClient mc, MatrixStack matrices, Snapshot s, int w, int h) {
+        int x = w / 2 - 91;
+        int y = h - 32 + 3;
+        drawTexture(matrices, x, y, 0, 64, 182, 5);
+        int filled = (int) (s.xpProgress * 183.0f);
+        if (filled > 0) {
+            drawTexture(matrices, x, y, 0, 69, Math.min(filled, 182), 5);
+        }
+        if (s.xpLevel > 0) {
+            String text = String.valueOf(s.xpLevel);
+            int textX = (w - mc.textRenderer.getWidth(text)) / 2;
+            int textY = h - 31 - 4;
+            mc.textRenderer.draw(matrices, text, textX + 1, textY, 0);
+            mc.textRenderer.draw(matrices, text, textX - 1, textY, 0);
+            mc.textRenderer.draw(matrices, text, textX, textY + 1, 0);
+            mc.textRenderer.draw(matrices, text, textX, textY - 1, 0);
+            mc.textRenderer.draw(matrices, text, textX, textY, 0x80FF20);
+            bindTexture(GUI_ICONS_TEXTURE);
+        }
+    }
+
+    private static void resetColor() {
+        //#if MC>=11700
+        //$$ RenderSystem.setShaderColor(1.0f, 1.0f, 1.0f, 1.0f);
+        //#else
+        RenderSystem.color4f(1.0f, 1.0f, 1.0f, 1.0f);
+        //#endif
+    }
+}
