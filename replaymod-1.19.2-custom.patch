+++ b/src/main/java/com/replaymod/render/audio/SoundRecorder.java
@@ -0,0 +1,202 @@
+package com.replaymod.render.audio;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.IntSupplier;
+
+/**
+ * Collects the sounds that the game would have played while a video is being rendered (rendering itself mutes
+ * all sound categories) together with the listener (camera) pose of every rendered frame.
+ * After rendering, {@link AudioMixer} turns this into an audio track.
+ *
+ * This class deliberately has no Minecraft dependencies.
+ */
+public final class SoundRecorder {
+    public static final int SAMPLE_RATE = 44100;
+
+    /** A single (one-shot) sound. */
+    public static final class Event {
+        public final double time; // seconds since video start
+        public final String namespace;
+        public final String path; // full resource path, e.g. "sounds/entity/pig/say1.ogg"
+        public final float volume; // already multiplied by category and master volume, in [0, 1]
+        public final float pitch;
+        public final double x, y, z;
+        public final boolean relative; // position relative to listener (non-positional sound)
+        public final boolean attenuate; // distance attenuation enabled
+        public final float maxDistance;
+
+        Event(double time, String namespace, String path, float volume, float pitch,
+              double x, double y, double z, boolean relative, boolean attenuate, float maxDistance) {
+            this.time = time;
+            this.namespace = namespace;
+            this.path = path;
+            this.volume = volume;
+            this.pitch = pitch;
+            this.x = x;
+            this.y = y;
+            this.z = z;
+            this.relative = relative;
+            this.attenuate = attenuate;
+            this.maxDistance = maxDistance;
+        }
+
+        public String key() {
+            return namespace + ":" + path;
+        }
+    }
+
+    /** Immutable result of a recording session. */
+    public static final class Snapshot {
+        public final int fps;
+        public final List<Event> events;
+        public final double[] poseX, poseY, poseZ, poseYaw; // indexed by frame
+        public final int poseCount;
+        public final String diagnostics;
+
+        Snapshot(int fps, List<Event> events, double[] x, double[] y, double[] z, double[] yaw, int poseCount, String diagnostics) {
+            this.diagnostics = diagnostics;
+            this.fps = fps;
+            this.events = events;
+            this.poseX = x;
+            this.poseY = y;
+            this.poseZ = z;
+            this.poseYaw = yaw;
+            this.poseCount = poseCount;
+        }
+    }
+
+    // Diagnostics (written to a small report file next to the video)
+    public static final int SEEN = 0, RECORDED = 1, SKIPPED_GUI = 2, SKIPPED_LOOPING = 3, SKIPPED_STREAMED_OR_MISSING = 4, SILENT = 5, FAILURES = 6;
+    private static final int[] stats = new int[7];
+    private static String lastFailure = "";
+
+    public static synchronized void count(int what) {
+        if (recording) stats[what]++;
+    }
+
+    public static synchronized void failure(Throwable t) {
+        if (recording) {
+            stats[FAILURES]++;
+            lastFailure = t.toString();
+        }
+    }
+
+    private static synchronized String diagnostics() {
+        return "play() calls seen=" + stats[SEEN]
+                + ", recorded=" + stats[RECORDED]
+                + ", skipped(gui)=" + stats[SKIPPED_GUI]
+                + ", skipped(looping)=" + stats[SKIPPED_LOOPING]
+                + ", skipped(streamed/missing)=" + stats[SKIPPED_STREAMED_OR_MISSING]
+                + ", dropped(silent volume)=" + stats[SILENT]
+                + ", errors=" + stats[FAILURES] + (lastFailure.isEmpty() ? "" : " (last: " + lastFailure + ")")
+                + ", listener poses=" + poseCount
+                + ", master=" + masterVolume + ", categories=" + categoryVolumes;
+    }
+
+    private static volatile boolean recording;
+    private static int fps;
+    private static IntSupplier frameSupplier;
+    private static float masterVolume = 1;
+    private static Map<String, Float> categoryVolumes = new HashMap<>();
+    private static final List<Event> events = new ArrayList<>();
+    private static double[] poseX = new double[0], poseY = new double[0], poseZ = new double[0], poseYaw = new double[0];
+    private static int poseCount;
+
+    private SoundRecorder() {}
+
+    public static boolean isRecording() {
+        return recording;
+    }
+
+    /**
+     * @param framesDone supplies the index of the frame currently being prepared (i.e. frames already finished)
+     * @param categoryVolumes the user's real volume sliders by sound category name (rendering mutes them)
+     */
+    public static synchronized void begin(int fps, IntSupplier framesDone, Map<String, Float> categoryVolumes, float masterVolume) {
+        events.clear();
+        poseCount = 0;
+        SoundRecorder.fps = fps;
+        SoundRecorder.frameSupplier = framesDone;
+        SoundRecorder.categoryVolumes = new HashMap<>(categoryVolumes);
+        SoundRecorder.masterVolume = masterVolume;
+        java.util.Arrays.fill(stats, 0);
+        lastFailure = "";
+        recording = true;
+    }
+
+    public static synchronized void abort() {
+        recording = false;
+        events.clear();
+        poseCount = 0;
+        frameSupplier = null;
+    }
+
+    /** Stops recording and returns everything that was recorded. */
+    public static synchronized Snapshot end() {
+        recording = false;
+        Snapshot snapshot = new Snapshot(
+                fps,
+                new ArrayList<>(events),
+                java.util.Arrays.copyOf(poseX, poseCount),
+                java.util.Arrays.copyOf(poseY, poseCount),
+                java.util.Arrays.copyOf(poseZ, poseCount),
+                java.util.Arrays.copyOf(poseYaw, poseCount),
+                poseCount,
+                diagnostics()
+        );
+        events.clear();
+        poseCount = 0;
+        frameSupplier = null;
+        return snapshot;
+    }
+
+    public static synchronized void recordSound(
+            String category, String namespace, String path,
+            float volume, float pitch,
+            double x, double y, double z,
+            boolean relative, boolean attenuate, float attenuationDistance
+    ) {
+        if (!recording || frameSupplier == null) return;
+        float categoryVolume = categoryVolumes.getOrDefault(category, 1f);
+        float gain = clamp(volume, 0, 1) * clamp(categoryVolume, 0, 1) * clamp(masterVolume, 0, 1);
+        if (gain <= 0) {
+            stats[SILENT]++;
+            return;
+        }
+        double time = frameSupplier.getAsInt() / (double) fps;
+        float maxDistance = Math.max(volume, 1) * attenuationDistance;
+        stats[RECORDED]++;
+        events.add(new Event(time, namespace, path, gain, clamp(pitch, 0.5f, 2f), x, y, z, relative, attenuate, maxDistance));
+    }
+
+    /** Records the listener pose for the given frame (a later call for the same frame overwrites the earlier one). */
+    public static synchronized void recordListener(int frame, double x, double y, double z, float yawDegrees) {
+        if (!recording || frame < 0) return;
+        if (frame >= poseX.length) {
+            int size = Math.max(frame + 1, poseX.length * 2 + 16);
+            poseX = java.util.Arrays.copyOf(poseX, size);
+            poseY = java.util.Arrays.copyOf(poseY, size);
+            poseZ = java.util.Arrays.copyOf(poseZ, size);
+            poseYaw = java.util.Arrays.copyOf(poseYaw, size);
+        }
+        // Fill any gap with the new pose so lookups never read garbage
+        for (int i = poseCount; i < frame; i++) {
+            poseX[i] = x;
+            poseY[i] = y;
+            poseZ[i] = z;
+            poseYaw[i] = yawDegrees;
+        }
+        poseX[frame] = x;
+        poseY[frame] = y;
+        poseZ[frame] = z;
+        poseYaw[frame] = yawDegrees;
+        poseCount = Math.max(poseCount, frame + 1);
+    }
+
+    private static float clamp(float v, float min, float max) {
+        return v < min ? min : (v > max ? max : v);
+    }
+}
