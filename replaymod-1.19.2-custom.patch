@@ -0,0 +1,87 @@
+package com.replaymod.render.mixin;
+
+import com.replaymod.core.versions.MCVer;
+import com.replaymod.recording.handler.RecordingEventHandler;
+import com.replaymod.render.audio.SoundRecorder;
+import net.minecraft.client.sound.Sound;
+import net.minecraft.client.sound.SoundInstance;
+import net.minecraft.client.sound.SoundSystem;
+import net.minecraft.sound.SoundCategory;
+import net.minecraft.util.Identifier;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/**
+ * Records every sound the game starts while a video is rendered (the renderer mutes all sound categories,
+ * so nothing would be audible otherwise). The sounds are mixed into an audio track after rendering.
+ */
+@Mixin(SoundSystem.class)
+public abstract class Mixin_RecordSounds {
+    /**
+     * While a replay is being recorded, stores every sound the player's game plays (footsteps, splashes, ...) in the
+     * replay, because the server never sends the player their own sounds.
+     */
+    @Inject(method = "play(Lnet/minecraft/client/sound/SoundInstance;)V", at = @At("HEAD"))
+    private void replayModRecording_recordLiveSound(SoundInstance instance, CallbackInfo ci) {
+        try {
+            if (MCVer.getMinecraft().worldRenderer == null) {
+                return;
+            }
+            RecordingEventHandler handler = ((RecordingEventHandler.RecordingEventSender) MCVer.getMinecraft().worldRenderer).getRecordingEventHandler();
+            if (handler != null) {
+                handler.getExtRecorder().onSound(instance);
+            }
+        } catch (Throwable ignored) {
+            // never break the game because of recording extras
+        }
+    }
+
+    @Inject(method = "play(Lnet/minecraft/client/sound/SoundInstance;)V", at = @At("HEAD"))
+    private void replayModRender_recordSound(SoundInstance instance, CallbackInfo ci) {
+        if (!SoundRecorder.isRecording()) {
+            return;
+        }
+        try {
+            SoundRecorder.count(SoundRecorder.SEEN);
+            if (instance.getCategory() == SoundCategory.MASTER) {
+                SoundRecorder.count(SoundRecorder.SKIPPED_GUI);
+                return; // GUI sounds (buttons, ...)
+            }
+            if (instance.isRepeatable() || !instance.canPlay()) {
+                SoundRecorder.count(SoundRecorder.SKIPPED_LOOPING);
+                return; // looping sounds would need start/stop tracking; not supported
+            }
+            if (instance.getSoundSet(MCVer.getMinecraft().getSoundManager()) == null) {
+                SoundRecorder.count(SoundRecorder.SKIPPED_STREAMED_OR_MISSING);
+                return;
+            }
+            Sound sound = instance.getSound();
+            if (sound == null || sound.isStreamed()) {
+                SoundRecorder.count(SoundRecorder.SKIPPED_STREAMED_OR_MISSING);
+                return; // music / long streamed sounds are not recorded
+            }
+            Identifier location = sound.getLocation();
+            String path = location.getPath();
+            if (!path.startsWith("sounds/")) {
+                path = "sounds/" + path;
+            }
+            if (!path.endsWith(".ogg")) {
+                path = path + ".ogg";
+            }
+            boolean attenuate = "LINEAR".equals(instance.getAttenuationType().name());
+            SoundRecorder.recordSound(
+                    instance.getCategory().getName(),
+                    location.getNamespace(), path,
+                    instance.getVolume(), instance.getPitch(),
+                    instance.getX(), instance.getY(), instance.getZ(),
+                    instance.isLooping() /* 1.16.4 name of the "relative" flag, remapped for newer versions */, attenuate, sound.getAttenuation()
+            );
+        } catch (Throwable t) {
+            // Never break the game because of audio recording
+            SoundRecorder.failure(t);
+            com.replaymod.render.ReplayModRender.LOGGER.debug("Failed to record sound", t);
+        }
+    }
+}
