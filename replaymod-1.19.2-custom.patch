+++ b/src/main/java/com/replaymod/render/audio/RenderAudio.java
@@ -0,0 +1,265 @@
+package com.replaymod.render.audio;
+
+import com.replaymod.core.versions.MCVer;
+import com.replaymod.render.RenderSettings;
+import net.minecraft.resource.Resource;
+import net.minecraft.util.Identifier;
+import org.apache.commons.io.IOUtils;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import static com.replaymod.render.ReplayModRender.LOGGER;
+
+/**
+ * Turns the sounds recorded by {@link SoundRecorder} into an audio track and adds it to the finished video using ffmpeg.
+ */
+public final class RenderAudio {
+    private RenderAudio() {}
+
+    /** Loads the raw bytes of a sound file. */
+    public interface SoundLoader {
+        byte[] load(String namespace, String path) throws IOException;
+    }
+
+    /** Loader which reads from Minecraft's resource manager (vanilla assets and resource packs). */
+    public static final SoundLoader MINECRAFT_LOADER = (namespace, path) -> {
+        Resource resource = MCVer.getMinecraft().getResourceManager().getResource(new Identifier(namespace, path));
+        try (InputStream in = resource.getInputStream()) {
+            return IOUtils.toByteArray(in);
+        }
+    };
+
+    public static void finish(File video, RenderSettings settings, int totalFrames) {
+        finish(video, settings.getExportCommandOrDefault(), totalFrames, MINECRAFT_LOADER);
+    }
+
+    /** Never throws: a failed audio step must not destroy the already rendered video. */
+    public static void finish(File video, String ffmpeg, int totalFrames, SoundLoader loader) {
+        SoundRecorder.Snapshot snapshot = SoundRecorder.end();
+        File wav = new File(video.getParentFile(), video.getName() + ".audio.wav");
+        StringBuilder report = new StringBuilder();
+        report.append("Replay Mod custom audio report\n");
+        report.append("video: ").append(video.getName()).append("\n");
+        report.append("ffmpeg: ").append(ffmpeg).append("\n");
+        report.append("frames: ").append(totalFrames).append(" @ ").append(snapshot.fps).append(" fps\n");
+        report.append(snapshot.diagnostics).append("\n");
+        try {
+            String codec = audioCodecFor(video.getName());
+            if (codec == null) {
+                report.append("RESULT: not adding sound, unsupported container (supported: mp4, mkv, mov, webm)\n");
+                return;
+            }
+            if (snapshot.events.isEmpty()) {
+                report.append("RESULT: no sounds were recorded, no audio track added\n");
+                return;
+            }
+
+            LOGGER.info("Mixing {} recorded sounds", snapshot.events.size());
+            report.append("--- recorded sounds (time s | file | volume | pitch | relative | attenuated | gainL/gainR) ---\n");
+            int listed = 0;
+            for (SoundRecorder.Event e : snapshot.events) {
+                if (listed++ >= 300) {
+                    report.append("... (").append(snapshot.events.size() - 300).append(" more)\n");
+                    break;
+                }
+                double[] g = AudioMixer.gains(snapshot, e, e.time);
+                report.append(String.format(Locale.ROOT, "%.2f | %s | %.2f | %.2f | %s | %s | %.3f/%.3f%n",
+                        e.time, e.key(), e.volume, e.pitch, e.relative, e.attenuate, g[0], g[1]));
+            }
+            report.append("--- end list ---\n");
+            Map<String, float[]> pcm = decodeAll(snapshot, ffmpeg, loader, report);
+            report.append("decoded ").append(pcm.size()).append(" distinct sound files\n");
+            AudioMixer.MixResult mix = AudioMixer.mixToWav(snapshot, pcm, totalFrames, wav);
+            report.append("mixed ").append(mix.mixed).append(" sounds, peak=").append(mix.peak).append("\n");
+            mux(ffmpeg, video, wav, codec, mix.normalizeGain());
+            report.append("RESULT: audio track added OK\n");
+        } catch (Throwable t) {
+            LOGGER.error("Failed to add sound to rendered video (the video itself is unaffected):", t);
+            java.io.StringWriter sw = new java.io.StringWriter();
+            t.printStackTrace(new java.io.PrintWriter(sw));
+            report.append("RESULT: FAILED\n").append(sw).append("\n");
+        } finally {
+            //noinspection ResultOfMethodCallIgnored
+            wav.delete();
+            try {
+                Files.write(new File(video.getParentFile(), video.getName() + ".audio-report.txt").toPath(),
+                        report.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            } catch (Throwable ignored) {
+            }
+        }
+    }
+
+    private static String audioCodecFor(String fileName) {
+        String name = fileName.toLowerCase(Locale.ROOT);
+        if (name.endsWith(".mp4") || name.endsWith(".mkv") || name.endsWith(".mov") || name.endsWith(".m4v")) {
+            return "aac";
+        }
+        if (name.endsWith(".webm")) {
+            return "libopus";
+        }
+        return null;
+    }
+
+    private static Map<String, float[]> decodeAll(SoundRecorder.Snapshot snapshot, String ffmpeg, SoundLoader loader, StringBuilder report) throws Exception {
+        // Load the raw files sequentially (resource manager access), decode them in parallel
+        Map<String, byte[]> raw = new HashMap<>();
+        for (SoundRecorder.Event event : snapshot.events) {
+            String key = event.key();
+            if (raw.containsKey(key)) continue;
+            if ("meta".equals(event.namespace)) { // Minecraft's placeholder for missing sounds
+                raw.put(key, null);
+                continue;
+            }
+            try {
+                raw.put(key, loader.load(event.namespace, event.path));
+            } catch (Throwable t) {
+                LOGGER.warn("Could not load sound {}: {}", key, t.toString());
+                report.append("could not load ").append(key).append(": ").append(t).append("\n");
+                raw.put(key, null);
+            }
+        }
+
+        ExecutorService pool = Executors.newFixedThreadPool(Math.max(1, Math.min(4, Runtime.getRuntime().availableProcessors())));
+        try {
+            Map<String, Future<float[]>> futures = new HashMap<>();
+            for (Map.Entry<String, byte[]> entry : raw.entrySet()) {
+                if (entry.getValue() == null) continue;
+                byte[] bytes = entry.getValue();
+                futures.put(entry.getKey(), pool.submit(() -> decodeToMono(ffmpeg, bytes)));
+            }
+            Map<String, float[]> result = new HashMap<>();
+            for (Map.Entry<String, Future<float[]>> entry : futures.entrySet()) {
+                try {
+                    result.put(entry.getKey(), entry.getValue().get());
+                } catch (Exception e) {
+                    LOGGER.warn("Could not decode sound {}: {}", entry.getKey(), e.toString());
+                    report.append("could not decode ").append(entry.getKey()).append(": ").append(e).append("\n");
+                }
+            }
+            return result;
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+
+    /** Decodes any audio file ffmpeg understands (e.g. ogg vorbis) to mono 32 bit float samples at 44.1 kHz. */
+    public static float[] decodeToMono(String ffmpeg, byte[] encoded) throws IOException, InterruptedException {
+        Process process = new ProcessBuilder(ffmpeg, "-v", "error", "-i", "pipe:0",
+                "-f", "f32le", "-ac", "1", "-ar", String.valueOf(SoundRecorder.SAMPLE_RATE), "pipe:1").start();
+        drain(process.getErrorStream());
+        Thread writer = new Thread(() -> {
+            try (OutputStream out = process.getOutputStream()) {
+                out.write(encoded);
+            } catch (IOException ignored) {
+                // ffmpeg may close its input early
+            }
+        }, "replaymod-audio-decode-writer");
+        writer.setDaemon(true);
+        writer.start();
+
+        byte[] decoded;
+        try (InputStream in = process.getInputStream()) {
+            decoded = IOUtils.toByteArray(in);
+        }
+        int exit = process.waitFor();
+        if (exit != 0 || decoded.length == 0) {
+            throw new IOException("ffmpeg exited with " + exit + " and produced " + decoded.length + " bytes");
+        }
+        FloatBuffer floats = ByteBuffer.wrap(decoded).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer();
+        float[] samples = new float[floats.remaining()];
+        floats.get(samples);
+        return samples;
+    }
+
+    /** Evens out loudness (game sounds like footsteps are very quiet next to e.g. block breaking) and prevents clipping. */
+    private static final String LOUDNESS_FILTER = "dynaudnorm=f=250:g=15:m=25:p=0.92,alimiter=limit=0.95";
+
+    static void mux(String ffmpeg, File video, File wav, String audioCodec, double gain) throws IOException, InterruptedException {
+        try {
+            muxOnce(ffmpeg, video, wav, audioCodec, LOUDNESS_FILTER);
+        } catch (IOException e) {
+            // e.g. an ffmpeg build without these filters: still add the audio, just without loudness processing
+            LOGGER.warn("Adding audio with loudness filter failed, retrying without it: {}", e.toString());
+            muxOnce(ffmpeg, video, wav, audioCodec, null);
+        }
+    }
+
+    private static void muxOnce(String ffmpeg, File video, File wav, String audioCodec, String filter) throws IOException, InterruptedException {
+        String name = video.getName();
+        int dot = name.lastIndexOf('.');
+        File tmp = new File(video.getParentFile(), name.substring(0, dot) + ".with-audio" + name.substring(dot));
+
+        List<String> cmd = new ArrayList<>();
+        cmd.add(ffmpeg);
+        cmd.add("-y");
+        cmd.add("-v");
+        cmd.add("error");
+        cmd.add("-i");
+        cmd.add(video.getAbsolutePath());
+        cmd.add("-i");
+        cmd.add(wav.getAbsolutePath());
+        cmd.add("-map");
+        cmd.add("0:v");
+        cmd.add("-map");
+        cmd.add("1:a");
+        cmd.add("-c:v");
+        cmd.add("copy");
+        if (filter != null) {
+            cmd.add("-af");
+            cmd.add(filter);
+        }
+        cmd.add("-c:a");
+        cmd.add(audioCodec);
+        cmd.add("-b:a");
+        cmd.add("192k");
+        cmd.add("-shortest");
+        String lower = name.toLowerCase(Locale.ROOT);
+        if (lower.endsWith(".mp4") || lower.endsWith(".mov") || lower.endsWith(".m4v")) {
+            cmd.add("-movflags");
+            cmd.add("+faststart");
+        }
+        cmd.add(tmp.getAbsolutePath());
+
+        Process process = new ProcessBuilder(cmd).redirectErrorStream(true).start();
+        process.getOutputStream().close();
+        ByteArrayOutputStream log = new ByteArrayOutputStream();
+        try (InputStream in = process.getInputStream()) {
+            IOUtils.copy(in, log);
+        }
+        int exit = process.waitFor();
+        if (exit != 0 || !tmp.exists() || tmp.length() == 0) {
+            //noinspection ResultOfMethodCallIgnored
+            tmp.delete();
+            throw new IOException("ffmpeg failed to add audio (exit " + exit + "): " + log.toString("UTF-8"));
+        }
+        Files.move(tmp.toPath(), video.toPath(), StandardCopyOption.REPLACE_EXISTING);
+    }
+
+    private static void drain(InputStream stream) {
+        Thread thread = new Thread(() -> {
+            try {
+                IOUtils.copy(stream, new ByteArrayOutputStream());
+            } catch (IOException ignored) {
+            }
+        }, "replaymod-audio-decode-stderr");
+        thread.setDaemon(true);
+        thread.start();
+    }
+}
